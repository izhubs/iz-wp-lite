<?xml version="1.0"?>
<ruleset name="iz-wp-lite">
    <description>iz-wp-lite PHP coding standards</description>

    <!-- Directories to check -->
    <file>web/app/mu-plugins</file>
    <file>config</file>

    <!-- Exclusions -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/web/wp/*</exclude-pattern>
    <exclude-pattern>*/web/app/plugins/*</exclude-pattern>

    <!-- PHP version target -->
    <config name="php_version" value="80200"/>

    <!-- Base standard: PSR-12 (modern PHP, less opinionated than WordPress standard) -->
    <rule ref="PSR12">
        <!-- Allow long lines in comment blocks (docstrings, DECISION blocks) -->
        <exclude name="Generic.Files.LineLength"/>
        <!-- Allow WordPress and Bedrock procedural scripts mixing symbol definitions and side effects -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
        <!-- Allow snake_case methods/functions standard in WordPress APIs -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
        <!-- Allow WordPress class naming conventions -->
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps"/>
        <!-- Allow flexible parenthesis spacing standard in WordPress codebases -->
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceBeforeCloseBracket"/>
        <exclude name="PSR2.ControlStructures.ControlStructureSpacing.SpacingAfterOpenBrace"/>
        <exclude name="PSR2.ControlStructures.ControlStructureSpacing.SpaceBeforeCloseBrace"/>
    </rule>

    <!-- WordPress-specific: allow echo with parens -->
    <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing">
        <properties>
            <property name="equalsSpacing" value="1"/>
        </properties>
    </rule>

    <!-- Only fail CI on errors, ignore warnings on exit -->
    <arg name="warning-severity" value="0"/>
    <arg value="s"/>
    <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
