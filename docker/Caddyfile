{
	admin off
	auto_https off
}

:8080 {
	root * /var/www/html/web
	encode gzip zstd

	# Security: block dotfiles, environment configurations, and database files
	@blocked {
		path */.*
		path *.env*
		path /config/*
		path /vendor/*
		path *.sqlite*
		path *.sqlite3*
		path *.db*
		path /app/database/*
	}
	respond @blocked 403

	# Block XML-RPC at network level (belt-and-suspenders with PHP mu-plugin)
	# WHY: Blocking at Caddy prevents the PHP process from even loading for
	# XML-RPC brute-force floods, reducing CPU burn under attack.
	@xmlrpc {
		path /xmlrpc.php
	}
	respond @xmlrpc 403

	# Rate limit wp-login.php: max 5 requests per 10 seconds per IP
	# WHY: Brute-force login attacks send hundreds of requests/second.
	# 5 req/10s allows normal login retries while blocking automated floods.
	# DECISION: Caddy rate_limit vs fail2ban / WHY: Caddy handles it natively
	# without external daemon. TRADE-OFF: Per-IP only, not per-user.
	# REF: https://caddyserver.com/docs/caddyfile/directives/rate_limit
	@wp_login {
		path /wp/wp-login.php /wp-login.php
	}
	rate_limit @wp_login 5r/10s

	# Rewrite legacy /wp-content/* requests to Bedrock /app/*
	@wp_content {
		path_regexp wpcontent ^/wp-content/(.*)$
	}
	rewrite @wp_content /app/{re.wpcontent.1}

	# Serve static files from document root
	file_server

	# Tier 2: Static Page Cache (Check for pre-rendered HTML cache before passing to PHP)
	# Compatible with Cache Enabler / WP Super Cache file structures
	@cached_page {
		not method POST
		not path_regexp ^/(wp-admin|wp-login\.php)
		not header Cookie "*wordpress_logged_in*"
		file {
			try_files /app/cache/page_cache/{uri}/index.html /app/cache/cache-enabler/{host}{uri}/index.html
		}
	}
	rewrite @cached_page {http.matchers.file.relative}

	# Forward PHP requests to PHP-FPM on port 9000
	php_fastcgi 127.0.0.1:9000 {
		index index.php
		env SERVER_PORT 8080
	}

	# Cache headers for static assets
	@static {
		path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.webp *.avif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
		level INFO
	}
}
