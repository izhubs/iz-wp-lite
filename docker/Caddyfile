{
	admin off
	auto_https off
}

:8080 {
	root * /var/www/html/web
	encode gzip zstd

	# Security: block dotfiles, environment configurations, and database files
	@blocked {
		path */.* *.env* /config/* /vendor/* *.sqlite* *.sqlite3* *.db* /app/database/*
	}
	respond @blocked 403

	# Block XML-RPC at network level (belt-and-suspenders with PHP mu-plugin)
	# WHY: Blocking at Caddy prevents the PHP process from even loading for
	# XML-RPC brute-force floods, reducing CPU burn under attack.
	@xmlrpc {
		path /xmlrpc.php
	}
	respond @xmlrpc 403

	# Rate limiting for wp-login.php
	# DECISION: rate_limit directive requires caddy-ratelimit third-party module.
	# Standard Caddy binary does NOT include it — using it here causes startup failure.
	#
	# Two options:
	#   Option A (Caddy native): Build custom Caddy with xcaddy:
	#     xcaddy build --with github.com/mholt/caddy-ratelimit
	#     Then uncomment: rate_limit @wp_login 5r/10s
	#
	#   Option B (PHP plugin, recommended for standard Docker image):
	#     composer require wpackagist-plugin/limit-login-attempts-reloaded
	#     Handles brute-force at PHP level without custom Caddy build.
	#
	# Option B is pre-listed in composer.json suggest block.
	# rate_limit @wp_login 5r/10s  ← DISABLED: requires xcaddy build

	# Rewrite legacy /wp-content/* requests to Bedrock /app/*
	@wp_content {
		path_regexp wpcontent ^/wp-content/(.*)$
	}
	rewrite @wp_content /app/{re.wpcontent.1}

	# Serve static files from document root
	file_server

	# Tier 2: Static Page Cache (Check for pre-rendered HTML cache before passing to PHP)
	# Compatible with Cache Enabler / WP Super Cache file structures
	@cached_page {
		not method POST
		not path_regexp ^/(wp-admin|wp-login\.php)
		not header Cookie "*wordpress_logged_in*"
		file {
			try_files /app/cache/page_cache/{path}/index.html /app/cache/cache-enabler/{host}{path}/index.html
		}
	}
	rewrite @cached_page {http.matchers.file.relative}

	# Forward PHP requests to PHP-FPM on port 9000
	php_fastcgi 127.0.0.1:9000 {
		index index.php
		env SERVER_PORT 8080
	}

	# Cache headers for static assets
	@static {
		path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.webp *.avif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
		level INFO
	}
}
