# Environment & credentials
.env
.env.*
!.env.example

# Composer dependencies & WordPress Core
/vendor/
/web/wp/

# WordPress mutable directories
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/database/*
!/web/app/database/.gitkeep
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/themes/*
!/web/app/themes/.gitkeep

# WordPress cache (Cache Enabler, WP Super Cache, WP Rocket)
/web/app/cache/
/web/app/advanced-cache.php
/web/app/object-cache.php

# PHP sessions
/web/app/sessions/

# IDE and OS artifacts
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# CI artifacts
/.phpcs-cache
