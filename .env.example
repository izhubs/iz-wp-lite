# ==============================================================================
# iz-wp-lite Environment Configuration
# ==============================================================================

WP_ENV=development
WP_HOME=http://localhost:8080
WP_SITEURL="${WP_HOME}/wp"

# Database Engine Selector: 'mysql' (Default & Production) | 'sqlite' (Development / Ephemeral Preview)
DB_ENGINE=mysql

# MariaDB / MySQL Configuration (Production Standard - 100% Plugin Compatible)
DB_NAME=wp_lite
DB_USER=wp_user
DB_PASSWORD=wp_secure_password
DB_HOST=mariadb:3306
# DB_PORT=3306
# DB_PREFIX=wp_

# SQLite Configuration (Used when DB_ENGINE=sqlite for local testing / instant demo)
DB_DIR=web/app/database
DB_FILE=.ht.sqlite

# Cloudflare R2 / AWS S3 Storage (Stage 2 Integration)
# S3_UPLOADS_BUCKET=my-r2-bucket
# S3_UPLOADS_KEY=your-access-key-id
# S3_UPLOADS_SECRET=your-secret-access-key
# S3_UPLOADS_REGION=auto
# S3_UPLOADS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_UPLOADS_BUCKET_URL=https://media.example.com

# Authentication Unique Keys and Salts
# Generate online: https://roots.io/salts.html
AUTH_KEY='iz_wp_lite_auth_key_replace_with_secure_random_salt_string_123456'
SECURE_AUTH_KEY='iz_wp_lite_sec_auth_key_replace_with_secure_random_salt_123456'
LOGGED_IN_KEY='iz_wp_lite_logged_in_key_replace_with_secure_random_salt_123456'
NONCE_KEY='iz_wp_lite_nonce_key_replace_with_secure_random_salt_string_123456'
AUTH_SALT='iz_wp_lite_auth_salt_replace_with_secure_random_salt_string_123456'
SECURE_AUTH_SALT='iz_wp_lite_sec_salt_replace_with_secure_random_salt_string_123456'
LOGGED_IN_SALT='iz_wp_lite_logged_salt_replace_with_secure_random_salt_string_123456'
NONCE_SALT='iz_wp_lite_nonce_salt_replace_with_secure_random_salt_string_123456'

# ==============================================================================
# VPS Tier — reminder: also update docker-compose.yml mem_limit values
# TIER 1 (512MB, ~$4.50/mo): default settings below
# TIER 2 (1GB,  ~$8/mo):    increase mem_limit in docker-compose.yml
# TIER 3 (2GB,  ~$15/mo):   increase mem_limit + enable Redis service
# ==============================================================================

# Custom Runtime Flags
# DISABLE_WP_CRON=false
# WP_DEBUG_LOG=/var/log/wordpress/debug.log

# Security Flags (controlled by 02-security-hardening.php mu-plugin)
# DISABLE_COMMENTS=false      # Set to 'true' to fully disable comments site-wide
#                             # Recommended for: landing pages, portfolio sites, agency sites

# Redis Object Cache (Tier 3 only — requires Redis service in docker-compose.yml)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DATABASE=0
