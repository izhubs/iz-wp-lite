{
  "name": "iz-wp-lite",
  "type": "web",
  "strategy": "zero-downtime",
  "port": 8080,
  "image": "ghcr.io/izhubs/iz-wp-lite:latest",
  "build": {
    "mode": "local",
    "builder": "dockerfile"
  },
  "env": {
    "WP_ENV": "production",
    "WP_HOME": "https://REPLACE_YOUR_DOMAIN",
    "WP_SITEURL": "https://REPLACE_YOUR_DOMAIN/wp",
    "DB_ENGINE": "mysql",
    "DB_HOST": "127.0.0.1:3306",
    "DB_NAME": "REPLACE_DB_NAME",
    "DB_USER": "REPLACE_DB_USER",
    "DB_PASSWORD": "REPLACE_DB_PASSWORD"
  },
  "healthcheck": {
    "path": "/wp/wp-login.php",
    "interval_seconds": 15,
    "timeout_seconds": 5,
    "max_retries": 5
  },
  "resources": {
    "memory_mb": 192,
    "cpu_cores": 1.0
  },
  "routes": [
    "REPLACE_YOUR_DOMAIN"
  ],
  "volumes": [
    "/var/lib/izdeploy/iz-wp-lite/uploads:/var/www/html/web/app/uploads",
    "/var/lib/izdeploy/iz-wp-lite/sessions:/var/lib/php/sessions",
    "/var/lib/izdeploy/iz-wp-lite/database:/var/www/html/web/app/database"
  ]
}
